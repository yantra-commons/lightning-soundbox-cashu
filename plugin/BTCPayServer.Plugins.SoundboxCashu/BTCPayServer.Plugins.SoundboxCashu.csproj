<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <PropertyGroup>
        <Product>Soundbox Cashu</Product>
        <Description>Accept Cashu ecash at the counter. Ecash is swapped at the merchant's chosen mint and immediately settled to the store's own Lightning node as an ordinary BTCPay invoice.</Description>
        <Version>0.1.0</Version>
    </PropertyGroup>
    <PropertyGroup>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <PreserveCompilationContext>false</PreserveCompilationContext>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <!--
      Where the BTCPay Server source lives. Defaults to a sibling clone, like
      the main Lightning Soundbox plugin; override to reuse an existing one:
        dotnet build -p:BTCPayServerDir=/path/to/btcpayserver
      Build against the BTCPay version you deploy to (see README).
    -->
    <PropertyGroup>
        <BTCPayServerDir Condition="'$(BTCPayServerDir)' == ''">$(MSBuildThisFileDirectory)..\btcpayserver</BTCPayServerDir>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ProjectReference>
            <Properties>StaticWebAssetsEnabled=false</Properties>
            <Private>false</Private>
            <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
        </ProjectReference>
    </ItemDefinitionGroup>
    <ItemGroup>
        <ProjectReference Include="$(BTCPayServerDir)\BTCPayServer\BTCPayServer.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Pinned to match BTCPayServer.Abstractions so the plugin loads
             against the host's already-loaded EF/Npgsql assemblies. -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11"/>
        <!-- The only dependency this plugin ships. NBitcoin embeds the same
             libsecp256k1 port but keeps it internal; the standalone package
             exposes the point arithmetic Cashu's blind signatures need. Pure
             C#, no native binaries. -->
        <PackageReference Include="NBitcoin.Secp256k1" Version="3.1.6"/>
        <!-- Microsoft.EntityFrameworkCore.Design is deliberately NOT referenced:
             it conflicts with BTCPayServer.Rating (NU1107). Migrations are
             hand-written; keep them in sync with SoundboxCashuDbContext. -->
    </ItemGroup>
</Project>
